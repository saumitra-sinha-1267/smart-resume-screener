# ==============================================================================
# Smart Resume Screener - Environment Configuration
# ==============================================================================

# [LLM Evaluation Providers]
# Google Gemini API key for structured multi-dimension candidate scoring (optional; falls back to calibrated rule engine if unset)
GEMINI_API_KEY=

# OpenAI API key (alternative LLM evaluation provider, optional)
OPENAI_API_KEY=

# [External Verification]
# GitHub Personal Access Token (PAT) to increase API rate limit from 60/hr to 5,000/hr for link liveness audits
GITHUB_TOKEN=

# [Screening Pipeline Settings]
# Number of candidates to pre-filter via dense sentence-transformers before heavy LLM scoring
TOP_N_FILTER=15

# Toggle active link and portfolio verification
ENABLE_LINK_CHECK=true

# [Storage Paths]
# Custom path for persistent SQLite database file
DATABASE_PATH=

# Custom directory for uploaded resume PDFs
UPLOADS_DIR=

# [Security & Networking]
# Comma-separated allowed frontend origins for CORS (DO NOT use '*' in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
